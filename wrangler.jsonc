// Configuration Cloudflare : le site (dossier public/) + le registre de la caserne (src/index.js).
{
  "name": "ancien-de-la-caserne-nf",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // active l'adresse publique https://ancien-de-la-caserne-nf.<compte>.workers.dev
  "workers_dev": true,
  // garde les journaux activés dans le tableau de bord
  "observability": { "enabled": true },
  // l'administrateur (le mot de passe est un secret Cloudflare : ADMIN_MOT_DE_PASSE, jamais dans ce fichier)
  "vars": { "ADMIN_PRENOM": "Germain-Pierre", "ADMIN_NOM": "Bouquet" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/videos/*"]
  },
  // compteur des numéros d'inscription (0001, 0002, …)
  "durable_objects": {
    "bindings": [{ "name": "COMPTEUR", "class_name": "Compteur" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Compteur"] }],
  // toutes les 15 minutes : une nouvelle version en ligne ? les abonnés aux notifications sont prévenus
  "triggers": { "crons": ["*/15 * * * *"] }
}
